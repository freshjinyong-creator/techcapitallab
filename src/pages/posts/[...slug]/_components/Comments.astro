---
type Props = {
  id?: string;
  title?: string;
  url?: string;
};

const {
  id = Astro.url.pathname,
  title = "",
  url = Astro.url.href,
} = Astro.props;
---

<section class="mt-8 w-full border-t border-dashed border-border pt-8">
  <h3 class="text-lg font-bold text-foreground mb-4 flex items-center gap-2">
    💬 댓글 작성
  </h3>
  <div id="disqus_thread" class="w-full min-h-[250px]"></div>
</section>

<script is:inline data-astro-rerun>
  function loadDisqus() {
    const thread = document.getElementById("disqus_thread");
    if (!thread) return;

    window.disqus_config = function () {
      this.page.url = window.location.href;
      this.page.identifier = window.location.pathname;
    };

    const oldScript = document.getElementById("disqus-script");
    if (oldScript) oldScript.remove();

    const d = document, s = d.createElement("script");
    s.id = "disqus-script";
    s.src = "https://techcapitallab.disqus.com/embed.js";
    s.setAttribute("data-timestamp", +new Date());
    (d.head || d.body).appendChild(s);
  }

  loadDisqus();
</script>
