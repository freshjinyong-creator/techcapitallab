  function updatePortfolioSummary(evaluated: any[]) {
    let totalCost = 0;
    let totalEval = 0;
    let alertCount = 0;

    for (const p of evaluated) {
      totalCost += p.buyPrice * p.qty;
      totalEval += p.currentPrice * p.qty;
      if (["SELL_STOP", "SELL_TRAIL", "TIME_STOP", "WARNING"].includes(p.signal)) {
        alertCount += 1;
      }
    }

    const netPnlKrw = Math.round(totalEval - totalCost - totalEval * 0.0023);
    const netPnlPct = totalCost > 0 ? ((netPnlKrw / totalCost) * 100) : 0;

    const costEl = document.getElementById("pf-total-cost");
    const evalEl = document.getElementById("pf-total-eval");
    const pnlEl = document.getElementById("pf-total-pnl");
    const alertEl = document.getElementById("pf-alert-count");

    if (costEl) costEl.textContent = `${totalCost.toLocaleString()} 원`;
    if (evalEl) evalEl.textContent = `${totalEval.toLocaleString()} 원`;
    if (pnlEl) {
      pnlEl.textContent = `${netPnlKrw >= 0 ? "+" : ""}${netPnlKrw.toLocaleString()} 원 (${netPnlPct >= 0 ? "+" : ""}${netPnlPct.toFixed(2)}%)`;
      pnlEl.className = `mt-1 text-sm sm:text-base font-bold font-mono ${netPnlKrw >= 0 ? "text-rose-400" : "text-blue-400"}`;
    }
    if (alertEl) {
      alertEl.textContent = `${alertCount} 종목`;
      alertEl.className = `mt-1 text-sm sm:text-base font-bold font-mono ${alertCount > 0 ? "text-rose-400" : "text-emerald-400"}`;
    }
  }

  async function syncPortfolioToServer() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(myPortfolio));
    try {
      await fetch("/api/quant-portfolio", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ portfolio: myPortfolio }),
      });
    } catch {
      // ignore on static hosting
    }
  }

  function setupSearchAutocomplete() {
    const input = document.getElementById("pf-input-search") as HTMLInputElement | null;
    const codeInput = document.getElementById("pf-input-code") as HTMLInputElement | null;
    const nameInput = document.getElementById("pf-input-name") as HTMLInputElement | null;
    const priceInput = document.getElementById("pf-input-price") as HTMLInputElement | null;
    const dropdown = document.getElementById("pf-search-dropdown");

    if (!input || !dropdown) return;

    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      if (!q) {
        dropdown.classList.add("hidden");
        return;
      }
      const matches = stockMasterList
        .filter(s => s.name.toLowerCase().includes(q) || s.code.includes(q))
        .slice(0, 12);

      if (matches.length === 0) {
        dropdown.classList.add("hidden");
        return;
      }

      dropdown.innerHTML = matches
        .map(
          s => `
          <button
            type="button"
            data-code="${s.code}"
            data-name="${s.name}"
            class="flex w-full items-center justify-between px-3 py-2 text-left hover:bg-accent/15 transition-colors cursor-pointer"
          >
            <span class="font-bold text-foreground">${s.name}</span>
            <span class="font-mono text-muted-foreground">${s.code}</span>
          </button>
        `
        )
        .join("");
      dropdown.classList.remove("hidden");
    });

    dropdown.addEventListener("click", async e => {
      const btn = (e.target as HTMLElement).closest("button[data-code]");
      if (!btn) return;
      const code = btn.getAttribute("data-code") || "";
      const name = btn.getAttribute("data-name") || "";
      input.value = `${name} (${code})`;
      if (codeInput) codeInput.value = code;
      if (nameInput) nameInput.value = name;
      dropdown.classList.add("hidden");

      // Pre-fill current price from live quote API
      try {
        const resp = await fetch(`/api/quant-quote?code=${code}`);
        if (resp.ok) {
          const d = await resp.json();
          if (priceInput && !priceInput.value && d.currentPrice) {
            priceInput.value = String(d.currentPrice);
          }
        }
      } catch {
        // ignore
      }
    });

    document.addEventListener("click", e => {
      if (!input.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
        dropdown.classList.add("hidden");
      }
    });
  }

  function parseSnapshotTimestamp(data: any): number {
    const raw = data?.generatedAt;
    if (typeof raw === "number" && Number.isFinite(raw)) return raw;
    if (typeof raw === "string" && raw.trim()) {
      const parsed = Date.parse(raw);
      if (!Number.isNaN(parsed)) return parsed;
    }
    return -Infinity;
  }

  async function fetchLatestAdvisorSnapshot(): Promise<any> {
    const ts = Date.now();
    const urls = [
      `https://pub-88fccd299b1d47fe97d43f35f238d0ce.r2.dev/data/quant_advisor_snapshot.json?t=${ts}`,
      `/data/quant_advisor_snapshot.json?t=${ts}`,
    ];

    const results = await Promise.allSettled(
      urls.map(async url => {
        const resp = await fetch(url);
        if (!resp.ok) {
          throw new Error(`HTTP ${resp.status} for ${url}`);
        }
        const data = await resp.json();
        if (!data || typeof data !== "object") {
          throw new Error(`Invalid snapshot JSON from ${url}`);
        }
        return data;
      })
    );

    const validSnapshots = results
      .filter((r): r is PromiseFulfilledResult<any> => r.status === "fulfilled")
      .map(r => r.value);

    if (validSnapshots.length === 0) {
      throw new Error("Failed to load quant_advisor_snapshot.json from both R2 and static fallback");
    }

    return validSnapshots.reduce((newest, candidate) =>
      parseSnapshotTimestamp(candidate) > parseSnapshotTimestamp(newest) ? candidate : newest
    );
  }

  async function initDashboard() {
    initAdvisorChart();

    // Set default date to today
    const dateInput = document.getElementById("pf-input-date") as HTMLInputElement | null;
    if (dateInput) {
      dateInput.value = new Date().toISOString().slice(0, 10);
    }

    // Load stock master list from R2 for autocomplete
    fetch("https://pub-88fccd299b1d47fe97d43f35f238d0ce.r2.dev/data/stock_list.json")
      .then(r => r.json())
      .then(list => {
        if (Array.isArray(list)) stockMasterList = list;
      })
      .catch(() => {});

    setupSearchAutocomplete();

    // Load snapshot JSON (R2 + static fallback, picking newest generatedAt)
    try {
      snapshotData = await fetchLatestAdvisorSnapshot();
      renderMacroBanner(snapshotData.macro, snapshotData.generatedAt, snapshotData.dataSource);
      renderRecommendations("track1");

      // Load initial chart with top #1 recommendation
      const firstPick =
        snapshotData.recommendations?.track1?.[0] ||
        snapshotData.recommendations?.track2?.[0];
      if (firstPick) {
        loadChartWithDefenseLines(
          firstPick.code,
          firstPick.name,
          firstPick.close,
          firstPick.recommendedStop,
          firstPick.sma20
        );
      }
    } catch (e) {
      console.error("Failed to load snapshot:", e);
    }

    // Load portfolio: try local dev API (/api/quant-portfolio) first, then localStorage, then /data/my_portfolio.json
    let loadedFromApi = false;
    try {
      const apiResp = await fetch(`/api/quant-portfolio?t=${Date.now()}`);
      const contentType = apiResp.headers.get("content-type") || "";
      if (apiResp.ok && contentType.includes("application/json")) {
        const data = await apiResp.json();
        if (Array.isArray(data?.portfolio)) {
          myPortfolio = data.portfolio;
          localStorage.setItem(STORAGE_KEY, JSON.stringify(myPortfolio));
          if (Array.isArray(data.portfolioEvaluated) && data.portfolioEvaluated.length > 0) {
            if (!snapshotData) snapshotData = {};
            snapshotData.portfolioEvaluated = data.portfolioEvaluated;
          }
          loadedFromApi = true;
        }
      }
    } catch {
      // Static prod or offline: fall back to localStorage / public JSON
    }

    if (!loadedFromApi) {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        try {
          const parsed = JSON.parse(saved);
          myPortfolio = Array.isArray(parsed) ? parsed : [];
        } catch {
          myPortfolio = [];
        }
      } else {
        try {
          const pfResp = await fetch(`/data/my_portfolio.json?t=${Date.now()}`);
          if (pfResp.ok) {
            const parsed = await pfResp.json();
            myPortfolio = Array.isArray(parsed) ? parsed : [];
            localStorage.setItem(STORAGE_KEY, JSON.stringify(myPortfolio));
          }
        } catch {
          myPortfolio = [];
        }
      }
    }

    await refreshAndRenderPortfolio();

    // Event Listeners: Track Tabs
    document.querySelectorAll(".track-tab-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const k = btn.getAttribute("data-track-tab") as "track1" | "track2" | "track3";
        if (k) renderRecommendations(k);
      });
    });

    // Event Listener: Add Position Form
    const form = document.getElementById("form-add-portfolio") as HTMLFormElement | null;
    if (form) {
      form.addEventListener("submit", async e => {
        e.preventDefault();
        const searchVal = (
          (document.getElementById("pf-input-search") as HTMLInputElement)?.value || ""
        ).trim();
        let code = (
          (document.getElementById("pf-input-code") as HTMLInputElement)?.value || ""
        ).trim();
        let name = (
          (document.getElementById("pf-input-name") as HTMLInputElement)?.value || ""
        ).trim();

        if (!code) {
          const codeMatch = searchVal.match(/\b(\d{6})\b/);
          if (codeMatch) {
            code = codeMatch[1];
            const found = stockMasterList.find(s => s.code === code);
            name = found ? found.name : code;
          } else {
            const found = stockMasterList.find(
              s => s.name.toLowerCase() === searchVal.toLowerCase()
            );
            if (found) {
              code = found.code;
              name = found.name;
            }
          }
        }

        if (!/^\d{6}$/.test(code)) {
          showToast("유효한 종목명 또는 6자리 종목코드를 선택해 주세요.");
          return;
        }

        const buyPrice = Number(
          (document.getElementById("pf-input-price") as HTMLInputElement)?.value || 0
        );
        const qty = Number(
          (document.getElementById("pf-input-qty") as HTMLInputElement)?.value || 1
        );
        const buyDate =
          (document.getElementById("pf-input-date") as HTMLInputElement)?.value ||
          new Date().toISOString().slice(0, 10);
        const track =
          (document.getElementById("pf-input-track") as HTMLSelectElement)?.value ||
          "TRACK_1_FIP_52W";

        if (buyPrice <= 0) {
          showToast("매수 평균단가를 입력해 주세요.");
          return;
        }

        const existingIdx = myPortfolio.findIndex(p => p.code === code);
        if (existingIdx >= 0) {
          myPortfolio[existingIdx] = { code, name: name || code, buyPrice, qty, buyDate, track };
        } else {
          myPortfolio.unshift({ code, name: name || code, buyPrice, qty, buyDate, track });
        }

        await syncPortfolioToServer();
        await refreshAndRenderPortfolio();
        showToast(`${name || code}(${code}) 종목이 내 보유 포트폴리오에 등록되었습니다.`);

        (document.getElementById("pf-input-search") as HTMLInputElement).value = "";
        (document.getElementById("pf-input-code") as HTMLInputElement).value = "";
        (document.getElementById("pf-input-name") as HTMLInputElement).value = "";
        (document.getElementById("pf-input-price") as HTMLInputElement).value = "";
      });
    }

    // Event Listener: Recommendation Cards Actions (+ Add to Portfolio / View Chart)
    const recContainer = document.getElementById("rec-cards-container");
    if (recContainer) {
      recContainer.addEventListener("click", async e => {
        const btn = (e.target as HTMLElement).closest("button[data-action]");
        if (!btn) return;
        const action = btn.getAttribute("data-action");
        const code = btn.getAttribute("data-code") || "";
        const name = btn.getAttribute("data-name") || "";

        if (action === "add-to-pf") {
          const price = Number(btn.getAttribute("data-price") || 0);
          const track = btn.getAttribute("data-track") || "TRACK_1_FIP_52W";
          const today = new Date().toISOString().slice(0, 10);
          const existingIdx = myPortfolio.findIndex(p => p.code === code);
          if (existingIdx >= 0) {
            myPortfolio[existingIdx] = { code, name, buyPrice: price, qty: 10, buyDate: today, track };
          } else {
            myPortfolio.unshift({ code, name, buyPrice: price, qty: 10, buyDate: today, track });
          }
          await syncPortfolioToServer();
          await refreshAndRenderPortfolio();
          showToast(`${name}(${code}) 종목을 현재가(${price.toLocaleString()}원) 기준으로 내 포트폴리오에 편입했습니다.`);
          document.getElementById("pf-cards-container")?.scrollIntoView({ behavior: "smooth" });
        } else if (action === "view-chart") {
          const entry = Number(btn.getAttribute("data-entry") || 0);
          const stop = Number(btn.getAttribute("data-stop") || 0);
          const sma20 = Number(btn.getAttribute("data-sma20") || 0);
          await loadChartWithDefenseLines(code, name, entry, stop, sma20);
          document.getElementById("advisor-chart-section")?.scrollIntoView({ behavior: "smooth" });
        }
      });
    }

    // Event Listener: Portfolio Cards Actions (View Chart / Telegram / Delete)
    const pfContainer = document.getElementById("pf-cards-container");
    if (pfContainer) {
      pfContainer.addEventListener("click", async e => {
        const btn = (e.target as HTMLElement).closest("button[data-pf-action]");
        if (!btn) return;
        const action = btn.getAttribute("data-pf-action");

        if (action === "delete") {
          const code = btn.getAttribute("data-code") || "";
          myPortfolio = myPortfolio.filter(p => p.code !== code);
          await syncPortfolioToServer();
          await refreshAndRenderPortfolio();
          showToast(`종목(${code})이 보유 포트폴리오에서 삭제되었습니다.`);
        } else if (action === "chart") {
          const code = btn.getAttribute("data-code") || "";
          const name = btn.getAttribute("data-name") || "";
          const entry = Number(btn.getAttribute("data-entry") || 0);
          const stop = Number(btn.getAttribute("data-stop") || 0);
          const sma20 = Number(btn.getAttribute("data-sma20") || 0);
          await loadChartWithDefenseLines(code, name, entry, stop, sma20);
          document.getElementById("advisor-chart-section")?.scrollIntoView({ behavior: "smooth" });
        } else if (action === "telegram") {
          const idx = Number(btn.getAttribute("data-idx") || 0);
          const p = evaluatedPortfolioCache[idx];
          if (!p) return;
          const text = [
            `[돈테크랩 포트폴리오 종목 진단 알림]`,
            `- 종목: ${p.name} (${p.code})`,
            `- 판정 신호: [${p.signal}] ${p.signalLabel}`,
            `- 매수가: ${Number(p.buyPrice).toLocaleString()}원 (${p.qty}주, ${p.holdDays}거래일 보유)`,
            `- 현재가: ${Number(p.currentPrice).toLocaleString()}원 (순손익 ${p.netPnlPct >= 0 ? "+" : ""}${p.netPnlPct}%, ${p.netPnlKrw >= 0 ? "+" : ""}${Number(p.netPnlKrw).toLocaleString()}원)`,
            `- EOD 손절선: ${Number(p.activeHardStop).toLocaleString()}원 (버퍼 ${p.distToStopPct}%)`,
            `- 20일 생명선: ${Number(p.sma20).toLocaleString()}원 (이격 ${p.distToSma20Pct}%)`,
            `- 어드바이스: ${p.advice}`,
          ].join("\n");

          showToast("텔레그램으로 종목 진단 알림을 발송 중입니다...");
          const resp = await fetch("/api/quant-quote", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ text }),
          });
          const resJson = await resp.json();
          if (resJson.ok) {
            showToast(`${p.name} 진단 리포트가 텔레그램으로 발송되었습니다.`);
          } else {
            showToast(`텔레그램 발송 실패: ${resJson.error || "설정 확인 필요"}`);
          }
        }
      });
    }

    // Event Listener: Refresh Portfolio button
    document.getElementById("btn-refresh-portfolio")?.addEventListener("click", async () => {
      showToast("보유 종목 실시간 시세 및 방어선을 갱신합니다...");
      await refreshAndRenderPortfolio();
      showToast("보유 종목 실시간 시세 갱신이 완료되었습니다.");
    });

    // Event Listener: Send Full Telegram Report
    document.getElementById("btn-send-telegram-all")?.addEventListener("click", async () => {
      if (!snapshotData) return;
      const m = snapshotData.macro;
      const lines: string[] = [
        `[돈테크랩 퀀트 어드바이저 & 포트폴리오 종합 리포트]`,
        `기준일시: ${new Date().toLocaleString("ko-KR")} (최근 장마감: ${m.lastMarketDate})`,
        `시장 레짐: ${m.regimeLabel} | Breadth(50일선): ${m.breadthPct}% | 권장 주식비중: ${m.recEquityExposurePct}%`,
        `KOSPI: ${m.kospiClose} (${m.kospiRet1d >= 0 ? "+" : ""}${m.kospiRet1d}%) | KOSDAQ: ${m.kosdaqClose} (${m.kosdaqRet1d >= 0 ? "+" : ""}${m.kosdaqRet1d}%)`,
        `----------------------------------------`,
        `[1. 내 보유 포트폴리오 진단 (${evaluatedPortfolioCache.length}종목)]`,
      ];
      for (const p of evaluatedPortfolioCache) {
        lines.push(
          `- ${p.name}(${p.code}): [${p.signalLabel}] 현재가 ${Number(p.currentPrice).toLocaleString()}원 / 매수가 ${Number(p.buyPrice).toLocaleString()}원 (${p.netPnlPct >= 0 ? "+" : ""}${p.netPnlPct}%) | 손절선 ${Number(p.activeHardStop).toLocaleString()}원 | 20일선 ${Number(p.sma20).toLocaleString()}원`
        );
      }
      lines.push(`----------------------------------------`);
      lines.push(`[2. 금일 추천 종목 상위 (Track 1 & Track 2)]`);
      for (const t of (snapshotData.recommendations?.track1 || []).slice(0, 3)) {
        lines.push(
          `- [Track1] ${t.name}(${t.code}): 현재가 ${Number(t.close).toLocaleString()}원 | 52주고가비율 ${t.ratio52wHigh}% | FIP ${t.fipId60} | 손절선 ${Number(t.recommendedStop).toLocaleString()}원`
        );
      }
      for (const t of (snapshotData.recommendations?.track2 || []).slice(0, 3)) {
        lines.push(
          `- [Track2] ${t.name}(${t.code}): 현재가 ${Number(t.close).toLocaleString()}원 | 거래량 ${Math.max(t.volRatio, t.recent3MaxVolRatio)}배 | 손절선 ${Number(t.recommendedStop).toLocaleString()}원`
        );
      }

      showToast("텔레그램으로 종합 리포트를 전송 중입니다...");
      const resp = await fetch("/api/quant-quote", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text: lines.join("\n") }),
      });
      const resJson = await resp.json();
      if (resJson.ok) {
        showToast("텔레그램 종합 리포트 발송이 완료되었습니다.");
      } else {
        showToast(`텔레그램 발송 안내: ${resJson.error}`);
      }
    });

    // Event Listener: Refresh Screener
    document.getElementById("btn-refresh-screener")?.addEventListener("click", async () => {
      showToast("전 종목 실시간 일봉 및 뉴스·수급 재스캔을 시작합니다 (약 5~8초 소요)...");
      try {
        const r = await fetch("/api/quant-refresh", { method: "POST" });
        if (r.ok) {
          snapshotData = await fetchLatestAdvisorSnapshot();
          renderMacroBanner(snapshotData.macro, snapshotData.generatedAt, snapshotData.dataSource);
          renderRecommendations(currentTrackTab);
          await refreshAndRenderPortfolio();
          showToast("실시간 종목 재스캔 및 추천 리스트 갱신이 완료되었습니다.");
          return;
        }
        showToast("정적 배포 환경에서는 기존 스냅샷을 리로드합니다.");
      } catch {
        showToast("스냅샷 데이터를 다시 불러왔습니다.");
      }
    });
  }

  initDashboard();
  document.addEventListener("astro:after-swap", initDashboard);
</script>
