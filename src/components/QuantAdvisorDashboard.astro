---
/**
 * QuantAdvisorDashboard.astro
 * KRX Quant Stock Recommendation & Portfolio Risk/Stop-Loss Advisor Dashboard
 * Strictly adheres to Zero Emoji and Data-Driven Quantitative Reporting rules.
 */
---

<div class="quant-advisor-wrapper my-4 flex flex-col gap-8 text-foreground">
  <!-- 1. Top Macro & Market Regime Banner -->
  <section class="rounded-2xl border border-border bg-muted/20 p-5 shadow-xs">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between border-b border-border/60 pb-4">
      <div>
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="rounded-md bg-accent/15 px-2.5 py-1 text-xs font-mono font-bold text-accent">
            KRX QUANT ADVISOR v1.0
          </span>
          <span id="macro-regime-badge" class="rounded-md bg-slate-700 px-3 py-1 text-xs font-bold text-white">
            레짐 데이터 로딩 중...
          </span>
          <span id="macro-data-source-badge" class="rounded-md border border-border bg-background px-2.5 py-1 text-[11px] font-mono font-bold text-muted-foreground">
            데이터 소스: 확인 중...
          </span>
          <span id="macro-updated-at" class="text-xs font-mono text-muted-foreground">
            기준일시: -
          </span>
        </div>
        <h2 class="mt-2 text-lg font-bold sm:text-xl">
          거시경제·시장 레짐 진단 및 권장 주식 비중
        </h2>
        <p id="macro-regime-desc" class="mt-1 text-xs sm:text-sm text-muted-foreground leading-relaxed">
          데이터를 불러오는 중입니다...
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <button
          id="btn-refresh-screener"
          class="rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-bold hover:border-accent hover:text-accent transition-colors cursor-pointer"
        >
          실시간 종목 재스캔
        </button>
        <button
          id="btn-send-telegram-all"
          class="rounded-xl bg-accent px-3.5 py-2 text-xs font-bold text-white hover:opacity-90 transition-opacity cursor-pointer"
        >
          텔레그램 전체 리포트 발송
        </button>
      </div>
    </div>

    <!-- Macro Metrics Grid -->
    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      <div class="rounded-xl border border-border/60 bg-background p-3">
        <div class="text-[11px] text-muted-foreground">KOSPI 지수 (20일선 비교)</div>
        <div id="metric-kospi" class="mt-1 text-base font-extrabold font-mono">-</div>
        <div id="metric-kospi-sub" class="mt-0.5 text-[11px] font-mono text-muted-foreground">-</div>
      </div>
      <div class="rounded-xl border border-border/60 bg-background p-3">
        <div class="text-[11px] text-muted-foreground">KOSDAQ 지수 (20일선 비교)</div>
        <div id="metric-kosdaq" class="mt-1 text-base font-extrabold font-mono">-</div>
        <div id="metric-kosdaq-sub" class="mt-0.5 text-[11px] font-mono text-muted-foreground">-</div>
      </div>
      <div class="rounded-xl border border-border/60 bg-background p-3">
        <div class="text-[11px] text-muted-foreground">Market Breadth (50일선 상회)</div>
        <div id="metric-breadth50" class="mt-1 text-base font-extrabold font-mono text-accent">-</div>
        <div class="mt-0.5 text-[11px] text-muted-foreground">공격 임계치: 55.0% 이상</div>
      </div>
      <div class="rounded-xl border border-border/60 bg-background p-3">
        <div class="text-[11px] text-muted-foreground">단기 Breadth (20일선 상회)</div>
        <div id="metric-breadth20" class="mt-1 text-base font-extrabold font-mono">-</div>
        <div class="mt-0.5 text-[11px] text-muted-foreground">단기 수급 확산도</div>
      </div>
      <div class="rounded-xl border border-border/60 bg-background p-3">
        <div class="text-[11px] text-muted-foreground">Minervini Stage 2 비율</div>
        <div id="metric-stage2" class="mt-1 text-base font-extrabold font-mono">-</div>
        <div class="mt-0.5 text-[11px] text-muted-foreground">완전 정배열 주도주 비율</div>
      </div>
      <div class="rounded-xl border border-border/60 bg-background p-3">
        <div class="text-[11px] text-muted-foreground">권장 총 주식 노출 비중</div>
        <div id="metric-exposure" class="mt-1 text-base font-extrabold font-mono text-emerald-400">-</div>
        <div id="metric-cash" class="mt-0.5 text-[11px] font-mono text-muted-foreground">권장 현금 비중: -</div>
      </div>
    </div>
  </section>

  <!-- 2. My Portfolio Management & Real-Time Stop/Trailing Advisor -->
  <section class="rounded-2xl border-2 border-accent/40 bg-background p-5 shadow-sm">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between border-b border-border pb-4">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-md bg-accent px-2 py-0.5 text-[11px] font-mono font-bold text-white">
            PORTFOLIO RISK ADVISOR
          </span>
          <span id="portfolio-data-source-badge" class="rounded-md border border-border bg-muted/40 px-2.5 py-0.5 text-[11px] font-mono font-bold text-muted-foreground">
            시세 소스: 대기 중
          </span>
          <h2 class="text-lg font-bold sm:text-xl">
            내 보유 종목 관리 및 실시간 손절·청산 어드바이저
          </h2>
        </div>
        <p class="mt-1 text-xs text-muted-foreground">
          매수한 종목과 매수가를 등록하면 KIS 공식 REST API(장애 시 네이버 폴백) 실시간 일봉·시세를 연동하여 종가 기준 손절선(-7% / 2ATR), 20일 생명선 이탈 여부, 보유일수 기반 시간손절 신호를 즉시 판정합니다.
        </p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button
          id="btn-refresh-portfolio"
          class="rounded-xl border border-border bg-muted/40 px-3 py-1.5 text-xs font-bold hover:border-accent hover:text-accent transition-colors cursor-pointer"
        >
          보유종목 실시간 시세 갱신
        </button>
      </div>
    </div>

    <!-- Add Position Form -->
    <form id="form-add-portfolio" class="mt-4 grid grid-cols-1 gap-3 rounded-xl bg-muted/25 p-4 sm:grid-cols-2 lg:grid-cols-6">
      <div class="relative lg:col-span-2">
        <label class="block text-[11px] font-bold text-muted-foreground mb-1">
          종목명 검색 또는 6자리 코드
        </label>
        <input
          type="text"
          id="pf-input-search"
          placeholder="예: SK하이닉스 또는 000660"
          autocomplete="off"
          required
          class="w-full rounded-lg border border-border bg-background px-3 py-2 text-xs font-medium focus:border-accent focus:outline-none"
        />
        <input type="hidden" id="pf-input-code" />
        <input type="hidden" id="pf-input-name" />
        <div
          id="pf-search-dropdown"
          class="absolute left-0 top-full z-50 mt-1 hidden max-h-56 w-full overflow-y-auto rounded-xl border border-border bg-background py-1 shadow-xl text-xs"
        ></div>
      </div>

      <div>
        <label class="block text-[11px] font-bold text-muted-foreground mb-1">
          매수 평균단가 (원)
        </label>
        <input
          type="number"
          id="pf-input-price"
          placeholder="예: 100900"
          min="1"
          step="1"
          required
          class="w-full rounded-lg border border-border bg-background px-3 py-2 text-xs font-mono focus:border-accent focus:outline-none"
        />
      </div>

      <div>
        <label class="block text-[11px] font-bold text-muted-foreground mb-1">
          보유 수량 (주)
        </label>
        <input
          type="number"
          id="pf-input-qty"
          value="10"
          min="1"
          step="1"
          required
          class="w-full rounded-lg border border-border bg-background px-3 py-2 text-xs font-mono focus:border-accent focus:outline-none"
        />
      </div>

      <div>
        <label class="block text-[11px] font-bold text-muted-foreground mb-1">
          매수 일자
        </label>
        <input
          type="date"
          id="pf-input-date"
          required
          class="w-full rounded-lg border border-border bg-background px-3 py-2 text-xs font-mono focus:border-accent focus:outline-none"
        />
      </div>

      <div class="flex flex-col justify-end">
        <label class="block text-[11px] font-bold text-muted-foreground mb-1">
          적용 전략 트랙
        </label>
        <div class="flex gap-1.5">
          <select
            id="pf-input-track"
            class="w-full rounded-lg border border-border bg-background px-2 py-2 text-xs font-medium focus:border-accent focus:outline-none"
          >
            <option value="TRACK_1_FIP_52W">Track 1 (신고가+FIP)</option>
            <option value="TRACK_2_VOL_BREAKOUT">Track 2 (거래량돌파)</option>
            <option value="TRACK_3_PULLBACK_WATCH">Track 3 (눌림목재돌파)</option>
          </select>
          <button
            type="submit"
            class="shrink-0 rounded-lg bg-accent px-3.5 py-2 text-xs font-bold text-white hover:opacity-90 transition-opacity cursor-pointer"
          >
            등록
          </button>
        </div>
      </div>
    </form>

    <!-- Portfolio Summary Bar -->
    <div id="pf-summary-bar" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-xl border border-border/60 bg-muted/15 p-3">
        <div class="text-[11px] text-muted-foreground">총 매수 원금</div>
        <div id="pf-total-cost" class="mt-1 text-sm sm:text-base font-bold font-mono">0 원</div>
      </div>
      <div class="rounded-xl border border-border/60 bg-muted/15 p-3">
        <div class="text-[11px] text-muted-foreground">현재 총 평가금액</div>
        <div id="pf-total-eval" class="mt-1 text-sm sm:text-base font-bold font-mono">0 원</div>
      </div>
      <div class="rounded-xl border border-border/60 bg-muted/15 p-3">
        <div class="text-[11px] text-muted-foreground">순평가손익 (수수료·세금 0.23% 차감)</div>
        <div id="pf-total-pnl" class="mt-1 text-sm sm:text-base font-bold font-mono">0 원 (0.00%)</div>
      </div>
      <div class="rounded-xl border border-border/60 bg-muted/15 p-3">
        <div class="text-[11px] text-muted-foreground">즉시 조치 필요 종목 (손절/이탈/경고)</div>
        <div id="pf-alert-count" class="mt-1 text-sm sm:text-base font-bold font-mono">0 종목</div>
      </div>
    </div>

    <!-- Portfolio Positions List -->
    <div id="pf-cards-container" class="mt-4 flex flex-col gap-3">
      <div class="rounded-xl border border-border/50 p-6 text-center text-xs text-muted-foreground">
        보유 종목을 평가하는 중입니다...
      </div>
    </div>
  </section>

  <!-- 3. Interactive Price & Stop/Trailing Line Chart Panel -->
  <section id="advisor-chart-section" class="rounded-2xl border border-border bg-background p-5 shadow-xs">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between border-b border-border/60 pb-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="rounded-md bg-muted px-2 py-0.5 text-[11px] font-mono font-bold text-foreground">
            PRICE & DEFENSE LINE VIEWER
          </span>
          <h3 id="chart-panel-title" class="text-base font-bold sm:text-lg">
            종목 차트 및 손절선·20일 생명선 시각화
          </h3>
        </div>
        <p id="chart-panel-subtitle" class="mt-0.5 text-xs text-muted-foreground">
          추천 종목 또는 보유 종목의 [차트 및 방어선 보기] 버튼을 클릭하면 일봉 캔들과 매수가·EOD 손절선(-7%/2ATR)·20일선이 차트 위에 표시됩니다.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
        <span class="flex items-center gap-1">
          <span class="inline-block h-0.5 w-3 bg-emerald-400"></span>매수/진입가
        </span>
        <span class="flex items-center gap-1">
          <span class="inline-block h-0.5 w-3 bg-rose-500"></span>EOD 손절선(-7%/2ATR)
        </span>
        <span class="flex items-center gap-1">
          <span class="inline-block h-0.5 w-3 bg-amber-400"></span>20일 생명선(SMA20)
        </span>
        <span class="flex items-center gap-1">
          <span class="inline-block h-0.5 w-3 bg-purple-400"></span>50일 수급선(SMA50)
        </span>
      </div>
    </div>

    <div class="mt-3 relative h-[340px] w-full rounded-xl border border-border bg-[#0b0e14] overflow-hidden">
      <div id="advisor-lw-chart" class="h-full w-full"></div>
    </div>
  </section>

  <!-- 4. Quant Recommended Stocks by Strategy Track -->
  <section class="rounded-2xl border border-border bg-background p-5 shadow-xs">
    <div class="border-b border-border pb-4">
      <div class="flex items-center gap-2">
        <span class="rounded-md bg-accent/15 px-2.5 py-0.5 text-[11px] font-mono font-bold text-accent">
          15-YEAR KRX VERIFIED SCREENER
        </span>
        <h2 class="text-lg font-bold sm:text-xl">
          서적·논문 정량 공식 및 실시간 뉴스·수급 기반 추천 종목
        </h2>
      </div>
      <p class="mt-1 text-xs text-muted-foreground">
        통합 Parquet 일봉(2012-01-02~2026-11-13, 2,416종목·3,652거래일, 왕복 0.35% 비용 반영) OOS 검증(5Y PF 1.91, CAGR +13.73%, MDD -16.18%) 기반 3대 트랙 조건과 KIS .mst·공시 Kill-Switch·실시간 수급을 결합한 스크리너입니다.
      </p>

      <!-- Track Tabs -->
      <div class="mt-4 flex flex-wrap gap-2">
        <button
          data-track-tab="track1"
          class="track-tab-btn rounded-xl border border-accent bg-accent text-white px-4 py-2 text-xs font-bold transition-colors cursor-pointer"
        >
          Track 1: 52주 신고가 + FIP 연속추세 (E2_S7)
        </button>
        <button
          data-track-tab="track2"
          class="track-tab-btn rounded-xl border border-border bg-muted/40 text-foreground px-4 py-2 text-xs font-bold hover:border-accent transition-colors cursor-pointer"
        >
          Track 2: 거래대금 폭발 기준봉 돌파 (E1_S8)
        </button>
        <button
          data-track-tab="track3"
          class="track-tab-btn rounded-xl border border-border bg-muted/40 text-foreground px-4 py-2 text-xs font-bold hover:border-accent transition-colors cursor-pointer"
        >
          Track 3: 기준봉 후 거래절벽 20일선 눌림목 (Type B 대기)
        </button>
      </div>
    </div>

    <!-- Track Strategy Specification Banner -->
    <div id="track-spec-banner" class="mt-4 rounded-xl border border-border/80 bg-muted/20 p-4 text-xs">
      <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
        <div>
          <span class="font-bold text-accent">[이론 및 학술 논문 근거]</span>
          <p id="spec-books" class="mt-0.5 text-foreground font-medium">-</p>
        </div>
        <div>
          <span class="font-bold text-emerald-400">[15년 KRX 실증 백테스트 성적 (수수료·슬리피지 0.35% 차감)]</span>
          <p id="spec-backtest" class="mt-0.5 text-foreground font-mono font-medium">-</p>
        </div>
        <div>
          <span class="font-bold text-muted-foreground">[진입 공식 (Entry Rule)]</span>
          <p id="spec-entry" class="mt-0.5 text-muted-foreground">-</p>
        </div>
        <div>
          <span class="font-bold text-rose-400">[청산 및 손절 공식 (Exit & Stop Rule)]</span>
          <p id="spec-exit" class="mt-0.5 text-muted-foreground">-</p>
        </div>
      </div>
    </div>

    <!-- Recommended Stock Cards Container -->
    <div id="rec-cards-container" class="mt-5 grid grid-cols-1 gap-4 lg:grid-cols-2">
      <div class="col-span-full rounded-xl border border-border/50 p-8 text-center text-xs text-muted-foreground">
        추천 종목 데이터를 불러오는 중입니다...
      </div>
    </div>
  </section>

  <!-- Toast Status Notification -->
  <div
    id="advisor-toast"
    class="fixed bottom-5 right-5 z-50 hidden max-w-md rounded-xl border border-accent bg-slate-900 px-4 py-3 text-xs font-medium text-white shadow-2xl"
  ></div>
</div>

<script>
  import { createChart, ColorType, CrosshairMode, CandlestickSeries, LineSeries } from "lightweight-charts";

  interface PortfolioItem {
    code: string;
    name: string;
    buyPrice: number;
    qty: number;
    buyDate: string;
    track: string;
  }

  const STORAGE_KEY = "tcl_quant_my_portfolio_v1";
  let snapshotData: any = null;
  let stockMasterList: Array<{ code: string; name: string; market?: string }> = [];
  let currentTrackTab: "track1" | "track2" | "track3" = "track1";
  let myPortfolio: PortfolioItem[] = [];
  let evaluatedPortfolioCache: any[] = [];

  // Chart references
  let lwChart: any = null;
  let candleSeries: any = null;
  let sma20Series: any = null;
  let sma50Series: any = null;
  let priceLines: any[] = [];
  let chartResizeObserver: ResizeObserver | null = null;
  let chartRequestSeq = 0;

  function showToast(msg: string, duration = 4000) {
    const el = document.getElementById("advisor-toast");
    if (!el) return;
    el.textContent = msg;
    el.classList.remove("hidden");
    setTimeout(() => {
      el.classList.add("hidden");
    }, duration);
  }

  function initAdvisorChart() {
    const container = document.getElementById("advisor-lw-chart");
    if (!container) return;

    if (chartResizeObserver) {
      chartResizeObserver.disconnect();
      chartResizeObserver = null;
    }
    if (lwChart) {
      try {
        lwChart.remove();
      } catch {
        // ignore
      }
      lwChart = null;
      candleSeries = null;
      sma20Series = null;
      sma50Series = null;
      priceLines = [];
    }
    container.innerHTML = "";

    lwChart = createChart(container, {
      layout: {
        background: { type: ColorType.Solid, color: "#0b0e14" },
        textColor: "#94a3b8",
        attributionLogo: false,
      },
      grid: {
        vertLines: { color: "rgba(148, 163, 184, 0.08)" },
        horzLines: { color: "rgba(148, 163, 184, 0.08)" },
      },
      crosshair: { mode: CrosshairMode.Normal },
      rightPriceScale: { borderColor: "rgba(148, 163, 184, 0.2)" },
      timeScale: { borderColor: "rgba(148, 163, 184, 0.2)", timeVisible: false },
      width: container.clientWidth,
      height: container.clientHeight || 340,
    });

    candleSeries = lwChart.addSeries(CandlestickSeries, {
      upColor: "#ef4444",
      downColor: "#3b82f6",
      borderUpColor: "#ef4444",
      borderDownColor: "#3b82f6",
      wickUpColor: "#ef4444",
      wickDownColor: "#3b82f6",
    });

    sma20Series = lwChart.addSeries(LineSeries, {
      color: "#fbbf24",
      lineWidth: 2,
      title: "20일선(생명선)",
    });

    sma50Series = lwChart.addSeries(LineSeries, {
      color: "#c084fc",
      lineWidth: 2,
      title: "50일선(수급선)",
    });

    if (typeof ResizeObserver !== "undefined") {
      chartResizeObserver = new ResizeObserver(() => {
        if (lwChart && container && container.clientWidth > 0) {
          lwChart.applyOptions({ width: container.clientWidth });
        }
      });
      chartResizeObserver.observe(container);
    }
  }

  function clearPriceLines() {
    if (!candleSeries) return;
    for (const pl of priceLines) {
      try {
        candleSeries.removePriceLine(pl);
      } catch {
        // ignore
      }
    }
    priceLines = [];
  }

  function normalizeBarDate(raw: unknown): string | null {
    if (typeof raw !== "string") return null;
    const trimmed = raw.trim();
    if (/^\d{4}-\d{2}-\d{2}$/.test(trimmed)) return trimmed;
    if (/^\d{8}$/.test(trimmed)) {
      return `${trimmed.slice(0, 4)}-${trimmed.slice(4, 6)}-${trimmed.slice(6, 8)}`;
    }
    return null;
  }

  function normalizeChartBar(raw: any) {
    if (!raw || typeof raw !== "object") return null;
    const time = normalizeBarDate(raw.time ?? raw.date);
    const open = Number(raw.open);
    const high = Number(raw.high);
    const low = Number(raw.low);
    const close = Number(raw.close);
    if (
      !time ||
      !Number.isFinite(open) ||
      !Number.isFinite(high) ||
      !Number.isFinite(low) ||
      !Number.isFinite(close)
    ) {
      return null;
    }
    return { time, open, high, low, close };
  }

  async function loadChartWithDefenseLines(
    code: string,
    name: string,
    entryPrice: number,
    stopPrice: number,
    sma20Price: number
  ) {
    const requestSeq = ++chartRequestSeq;
    const titleEl = document.getElementById("chart-panel-title");
    const subEl = document.getElementById("chart-panel-subtitle");
    if (titleEl) {
      titleEl.textContent = `${name} (${code}) - 일봉 및 핵심 방어선 (손절선 ${stopPrice.toLocaleString()}원 / 20일선 ${sma20Price.toLocaleString()}원)`;
    }

    try {
      const [r2Settled, liveSettled] = await Promise.allSettled([
        fetch(`https://pub-88fccd299b1d47fe97d43f35f238d0ce.r2.dev/data/daily/${code}.json?t=${Date.now()}`),
        fetch(`/api/quant-quote?code=${code}`),
      ]);

      if (requestSeq !== chartRequestSeq) return;

      const barMap = new Map<
        string,
        { time: string; open: number; high: number; low: number; close: number }
      >();

      if (r2Settled.status === "fulfilled" && r2Settled.value.ok) {
        try {
          const r2Data = await r2Settled.value.json();
          if (requestSeq !== chartRequestSeq) return;
          if (Array.isArray(r2Data)) {
            for (const item of r2Data) {
              const bar = normalizeChartBar(item);
              if (bar) barMap.set(bar.time, bar);
            }
          }
        } catch {
          // ignore malformed R2 JSON
        }
      }

      if (liveSettled.status === "fulfilled" && liveSettled.value.ok) {
        try {
          const liveData = await liveSettled.value.json();
          if (requestSeq !== chartRequestSeq) return;
          if (Array.isArray(liveData?.recentBars)) {
            for (const item of liveData.recentBars) {
              const bar = normalizeChartBar(item);
              if (bar) barMap.set(bar.time, bar);
            }
          }
        } catch {
          // ignore non-JSON or malformed live quote response
        }
      }

      if (requestSeq !== chartRequestSeq) return;

      const bars = Array.from(barMap.values()).sort((a, b) => a.time.localeCompare(b.time));
      if (bars.length === 0 || !candleSeries || !sma20Series || !sma50Series || !lwChart) return;

      candleSeries.setData(bars);

      // Compute SMA20 and SMA50 across full merged history
      const sma20Data: { time: string; value: number }[] = [];
      const sma50Data: { time: string; value: number }[] = [];
      let sum20 = 0;
      let sum50 = 0;
      for (let i = 0; i < bars.length; i++) {
        sum20 += bars[i].close;
        if (i >= 20) sum20 -= bars[i - 20].close;
        if (i >= 19) {
          sma20Data.push({ time: bars[i].time, value: Math.round(sum20 / 20) });
        }

        sum50 += bars[i].close;
        if (i >= 50) sum50 -= bars[i - 50].close;
        if (i >= 49) {
          sma50Data.push({ time: bars[i].time, value: Math.round(sum50 / 50) });
        }
      }
      sma20Series.setData(sma20Data);
      sma50Series.setData(sma50Data);

      clearPriceLines();

      if (entryPrice > 0) {
        priceLines.push(
          candleSeries.createPriceLine({
            price: entryPrice,
            color: "#10b981",
            lineWidth: 2,
            lineStyle: 0,
            axisLabelVisible: true,
            title: `매수/기준가 (${entryPrice.toLocaleString()}원)`,
          })
        );
      }

      if (stopPrice > 0) {
        priceLines.push(
          candleSeries.createPriceLine({
            price: stopPrice,
            color: "#f43f5e",
            lineWidth: 2,
            lineStyle: 2,
            axisLabelVisible: true,
            title: `EOD 손절선 (${stopPrice.toLocaleString()}원)`,
          })
        );
      }

      if (bars.length > 110) {
        lwChart.timeScale().setVisibleLogicalRange({
          from: Math.max(0, bars.length - 110),
          to: bars.length + 4,
        });
      } else {
        lwChart.timeScale().fitContent();
      }

      if (subEl) {
        const lastBar = bars[bars.length - 1];
        subEl.textContent = `최근 기준일(${lastBar.time}) 종가: ${lastBar.close.toLocaleString()}원 | 매수/기준가: ${entryPrice.toLocaleString()}원 | EOD 손절선: ${stopPrice.toLocaleString()}원 | 20일 생명선: ${sma20Price.toLocaleString()}원`;
      }
    } catch (e) {
      console.error("Chart load error:", e);
    }
  }

  function formatDataSourceBadge(ds: string): { label: string; cls: string } {
    const base = "rounded-md border px-2.5 py-1 text-[11px] font-mono font-bold ";
    if (ds === "KIS_REST_PROD") {
      return {
        label: "KIS 공식 REST API (PROD)",
        cls: base + "border-emerald-500/40 bg-emerald-500/10 text-emerald-400",
      };
    }
    if (ds === "KIS_REST_VPS") {
      return {
        label: "KIS 공식 REST API (VPS)",
        cls: base + "border-sky-500/40 bg-sky-500/10 text-sky-400",
      };
    }
    if (ds === "NAVER_FALLBACK") {
      return {
        label: "NAVER FALLBACK",
        cls: base + "border-amber-500/40 bg-amber-500/10 text-amber-400",
      };
    }
    if (ds === "SNAPSHOT_FALLBACK") {
      return {
        label: "스냅샷 폴백",
        cls: base + "border-slate-500/40 bg-slate-500/10 text-slate-300",
      };
    }
    return {
      label: ds || "SNAPSHOT",
      cls: base + "border-border bg-background text-muted-foreground",
    };
  }

