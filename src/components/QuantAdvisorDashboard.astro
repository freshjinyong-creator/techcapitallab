  function evaluatePositionClientSide(item: PortfolioItem, quote: any) {
    const c = Number(quote.currentPrice || item.buyPrice);
    const buyPrice = Number(item.buyPrice);
    const qty = Number(item.qty || 1);
    const sma20 = Number(quote.sma20 || c);
    const sma50 = Number(quote.sma50 || c);
    const atr20 = Number(quote.atr20 || Math.round(c * 0.025));

    const grossPnlPct = ((c / buyPrice - 1) * 100);
    const netPnlPct = grossPnlPct - 0.23;
    const netPnlKrw = Math.round((c - buyPrice) * qty - c * qty * 0.0023);

    const hardStop7pct = Math.round(buyPrice * 0.93);
    const atrStop2x = Math.round(buyPrice - 2.0 * atr20);
    const activeHardStop = Math.max(hardStop7pct, atrStop2x);

    const distToStopPct = ((c - activeHardStop) / c) * 100;
    const distToSma20Pct = ((c - sma20) / c) * 100;

    // Calculate holding days from recentBars if available
    const buyDateClean = (item.buyDate || "").replace(/-/g, "");
    let holdDays = 1;
    let mfePct = Math.max(0, grossPnlPct);
    if (Array.isArray(quote.recentBars) && buyDateClean.length === 8) {
      const heldBars = quote.recentBars.filter((b: any) => b.date >= buyDateClean);
      holdDays = Math.max(1, heldBars.length);
      if (heldBars.length > 0) {
        const peak = Math.max(...heldBars.map((b: any) => b.high));
        mfePct = ((peak / buyPrice - 1) * 100);
      }
    }

    let signal = "HOLD";
    let signalLabel = "정상 보유 (추세 및 방어선 양호)";
    let advice = `현재가(${c.toLocaleString()}원)가 20일선(${sma20.toLocaleString()}원) 및 손절선(${activeHardStop.toLocaleString()}원) 위에서 정상 추세를 유지 중입니다. 종가 기준 방어선 이탈 전까지 보유를 유지합니다.`;

    if (c <= activeHardStop) {
      signal = "SELL_STOP";
      signalLabel = "손절 청산 신호 (EOD Hard Stop 이탈)";
      advice = `현재가(${c.toLocaleString()}원)가 설정된 손절선(${activeHardStop.toLocaleString()}원, 매수가 대비 -7% / 2ATR)을 하향 이탈했습니다. 15년 실증 백테스트 원칙에 따라 물타기나 비자발적 장기보유를 배제하고 장마감 동시호가 또는 익일 시가에 전량 기계적 손절을 권고합니다.`;
    } else if (c < sma20 && holdDays >= 2) {
      signal = "SELL_TRAIL";
      signalLabel = "추세 이탈 청산 신호 (20일 생명선 종가 이탈)";
      advice = `현재가(${c.toLocaleString()}원)가 20일 이동평균선(${sma20.toLocaleString()}원) 아래로 이탈했습니다 (현재 순손익 ${netPnlPct >= 0 ? "+" : ""}${netPnlPct.toFixed(2)}%). 추세추종 원칙상 20일선 종가 이탈은 중기 추세 종료를 의미하므로 익일 시가 전량 청산을 권고합니다.`;
    } else if (holdDays >= 10 && grossPnlPct < 3.0) {
      signal = "TIME_STOP";
      signalLabel = "시간 손절 권고 (10거래일 경과 탄력 둔화)";
      advice = `매수 후 ${holdDays}거래일이 경과했으나 수익률(${netPnlPct.toFixed(2)}%)이 목표 탄력(+3.0%)에 미달합니다. Mark Minervini 시간 손절(Time Stop) 원칙에 따라 기회비용 회수를 위해 신규 주도주로의 교체 매매를 권고합니다.`;
    } else if (distToStopPct <= 2.0 || distToSma20Pct <= 1.8) {
      signal = "WARNING";
      signalLabel = "주의 경계 (손절선/20일선 버퍼 2% 이내 근접)";
      advice = `현재가(${c.toLocaleString()}원)가 핵심 방어선(손절선 ${activeHardStop.toLocaleString()}원 / 20일선 ${sma20.toLocaleString()}원)에 근접했습니다. 장중 아랫꼬리 흔들기에는 매도하지 않되(EOD Stop 원칙), 15:20 종가 기준으로 방어선 하향 돌파 시 즉시 청산할 준비가 필요합니다.`;
    } else if (grossPnlPct >= 10.0) {
      signal = "HOLD_TRAIL";
      signalLabel = "수익 추세 순항 중 (조기 반익절 금지 / 20일선 트레일링)";
      advice = `현재 ${netPnlPct >= 0 ? "+" : ""}${netPnlPct.toFixed(2)}% 수익 구간입니다 (최고 도달 수익률 +${mfePct.toFixed(1)}%). 15년 KRX 실증 결과 +10% 조기 반익절은 손익비를 2.80에서 1.35로 훼손합니다. 20일선(${sma20.toLocaleString()}원) 종가 이탈 전까지 전량 보유(Let Winners Run)하십시오.`;
    }

    return {
      ...item,
      name: quote.name || item.name,
      currentPrice: c,
      ret1d: quote.ret1d || 0,
      grossPnlPct: Number(grossPnlPct.toFixed(2)),
      netPnlPct: Number(netPnlPct.toFixed(2)),
      netPnlKrw,
      holdDays,
      mfePct: Number(mfePct.toFixed(1)),
      sma20,
      sma50,
      atr20,
      activeHardStop,
      distToStopPct: Number(distToStopPct.toFixed(2)),
      distToSma20Pct: Number(distToSma20Pct.toFixed(2)),
      signal,
      signalLabel,
      advice,
      foreign5dNet: quote.foreign5dNet || 0,
      inst5dNet: quote.inst5dNet || 0,
      news: quote.news || [],
    };
  }

