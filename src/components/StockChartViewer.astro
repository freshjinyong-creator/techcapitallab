---
/**
 * StockChartViewer.astro
 * Interactive stock chart & backtesting component powered by TradingView Lightweight Charts
 */
interface Props {
  initialCode?: string;
  defaultTab?: "chart" | "backtest";
}

const { initialCode = "000660", defaultTab = "chart" } = Astro.props;
---

<div class="stock-chart-viewer my-6 w-full rounded-2xl border border-border bg-background p-4 shadow-sm sm:p-6">
  <!-- Stock Search & Summary Bar -->
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="relative flex-1 max-w-md">
      <div class="relative">
        <input
          type="text"
          id="stock-search-input"
          placeholder="종목명 또는 6자리 코드 검색 (예: 삼성전자, 000660)"
          class="w-full rounded-xl border border-border bg-muted/40 px-4 py-2.5 pl-10 text-sm font-medium text-foreground placeholder:text-muted-foreground focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
        />
        <svg
          class="absolute left-3 top-3 size-4 text-muted-foreground"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <!-- Auto-complete Dropdown -->
      <div
        id="stock-search-dropdown"
        class="absolute left-0 top-full z-50 mt-1.5 hidden max-h-64 w-full overflow-y-auto rounded-xl border border-border bg-background py-1.5 shadow-xl"
      ></div>
    </div>

    <!-- Quick Stock Pills -->
    <div class="flex flex-wrap items-center gap-1.5 text-xs">
      <span class="text-muted-foreground mr-1">인기 종목:</span>
      <button class="quick-stock-btn rounded-lg bg-muted/60 px-2.5 py-1 font-medium hover:bg-accent/20 hover:text-accent transition-colors" data-code="000660" data-name="SK하이닉스">SK하이닉스</button>
      <button class="quick-stock-btn rounded-lg bg-muted/60 px-2.5 py-1 font-medium hover:bg-accent/20 hover:text-accent transition-colors" data-code="005930" data-name="삼성전자">삼성전자</button>
      <button class="quick-stock-btn rounded-lg bg-muted/60 px-2.5 py-1 font-medium hover:bg-accent/20 hover:text-accent transition-colors" data-code="012450" data-name="한화에어로스페이스">한화에어로스페이스</button>
      <button class="quick-stock-btn rounded-lg bg-muted/60 px-2.5 py-1 font-medium hover:bg-accent/20 hover:text-accent transition-colors" data-code="086520" data-name="에코프로">에코프로</button>
      <button class="quick-stock-btn rounded-lg bg-muted/60 px-2.5 py-1 font-medium hover:bg-accent/20 hover:text-accent transition-colors" data-code="005380" data-name="현대차">현대차</button>
    </div>
  </div>

  <!-- Selected Stock Title & Real-time Quote Card -->
  <div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-y border-border/60 py-3">
    <div class="flex items-baseline gap-2.5">
      <h2 id="current-stock-name" class="text-xl font-bold text-foreground sm:text-2xl">SK하이닉스</h2>
      <span id="current-stock-code" class="text-sm font-mono text-muted-foreground">000660</span>
      <span id="current-stock-bars" class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground font-mono">-</span>
    </div>

    <div class="flex items-baseline gap-3">
      <div id="current-stock-price" class="text-2xl font-extrabold font-mono text-foreground sm:text-3xl">- 원</div>
      <div id="current-stock-change" class="text-sm font-semibold font-mono text-muted-foreground">-</div>
    </div>
  </div>

  <!-- Tabs Navigation -->
  <div class="mb-4 flex items-center justify-between border-b border-border">
    <div class="flex items-center gap-2">
      <button
        id="tab-btn-chart"
        class="tab-btn active-tab flex items-center gap-1.5 border-b-2 border-accent px-4 py-2.5 text-sm font-bold text-accent transition-colors"
      >
        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
        </svg>
        기본 차트 보기
      </button>
      <button
        id="tab-btn-backtest"
        class="tab-btn flex items-center gap-1.5 border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
      >
        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        실전 전략 백테스터
      </button>
    </div>

    <!-- Chart Quick Controls -->
    <div id="chart-controls" class="flex flex-wrap items-center gap-1.5 text-xs">
      <button id="btn-fit-chart" class="rounded-lg bg-muted/70 px-2.5 py-1 font-medium hover:bg-muted transition-colors cursor-pointer">
        전체 보기
      </button>
    </div>
  </div>

  <!-- Section 1: Chart View -->
  <div id="section-chart" class="flex flex-col gap-3">
    <!-- Indicator Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl bg-muted/30 p-2.5 text-xs">
      <!-- MA Checkboxes -->
      <div class="flex flex-wrap items-center gap-3">
        <span class="font-bold text-foreground">이동평균선:</span>
        <label class="flex items-center gap-1 cursor-pointer">
          <input type="checkbox" id="toggle-ma-5" checked class="accent-[#e91e63]" />
          <span class="inline-block size-2 rounded-full bg-[#e91e63]"></span>
          <span class="font-mono">5일</span>
        </label>
        <label class="flex items-center gap-1 cursor-pointer">
          <input type="checkbox" id="toggle-ma-20" checked class="accent-[#ff9800]" />
          <span class="inline-block size-2 rounded-full bg-[#ff9800]"></span>
          <span class="font-mono">20일</span>
        </label>
        <label class="flex items-center gap-1 cursor-pointer">
          <input type="checkbox" id="toggle-ma-60" checked class="accent-[#4caf50]" />
          <span class="inline-block size-2 rounded-full bg-[#4caf50]"></span>
          <span class="font-mono">60일</span>
        </label>
        <label class="flex items-center gap-1 cursor-pointer">
          <input type="checkbox" id="toggle-ma-120" checked class="accent-[#9c27b0]" />
          <span class="inline-block size-2 rounded-full bg-[#9c27b0]"></span>
          <span class="font-mono">120일</span>
        </label>
        <label class="flex items-center gap-1 cursor-pointer">
          <input type="checkbox" id="toggle-bb" class="accent-[#00bcd4]" />
          <span class="inline-block size-2 rounded-full bg-[#00bcd4]"></span>
          <span>볼린저밴드(20,2)</span>
        </label>
      </div>

      <!-- Sub-Indicator Select -->
      <div class="flex items-center gap-2">
        <span class="font-bold text-foreground">하단 보조지표:</span>
        <select id="select-sub-indicator" class="rounded-lg border border-border bg-background px-2.5 py-1 font-medium text-foreground focus:outline-none">
          <option value="none">없음</option>
          <option value="rsi" selected>RSI (14)</option>
          <option value="macd">MACD (12, 26, 9)</option>
        </select>
      </div>
    </div>

    <!-- Lecture Pattern Finder Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-accent/30 bg-accent/5 p-3 text-xs">
      <div class="flex items-center gap-2">
        <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-accent text-white font-bold text-sm shadow-xs">🎓</span>
        <div>
          <div class="font-bold text-foreground text-sm sm:text-xs">강의 실전 패턴 탐색기 (1-1강 & 1-2강)</div>
          <div class="text-[11px] text-muted-foreground hidden sm:block">블로그 강의에서 다룬 실전 캔들 기법이 터진 역사적 타점들을 차트에서 즉시 탐색 및 이동합니다.</div>
        </div>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto">
        <select id="select-lecture-pattern" class="w-full sm:w-auto rounded-xl border border-accent/40 bg-background px-3 py-1.5 text-xs font-bold text-foreground focus:border-accent focus:outline-none shadow-xs">
          <option value="NONE">-- 🎓 강의 실전 패턴 탐색 선택 (해제) --</option>
          <option value="LECTURE_INVERTED_HAMMER">🔨 [1-1강 실전] 바닥권 역망치 매집봉 (거래량 폭증 + 위꼬리)</option>
          <option value="LECTURE_BULLISH_ENGULFING">🟢 [1-2강 실전] 20일선 눌림목 상승장악형 (Bullish Engulfing)</option>
          <option value="LECTURE_BEARISH_ENGULFING">⚠️ [1-2강 경고] 고점 하락장악형 (설거지 장대음봉 탈출)</option>
        </select>
      </div>
    </div>

    <!-- Pattern Occurrences Navigator Panel -->
    <div id="lecture-pattern-navigator" class="hidden rounded-xl border border-border bg-muted/20 p-3 text-xs">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border/50 pb-2 mb-2">
        <div class="flex items-center gap-2">
          <span id="pat-badge" class="px-2 py-0.5 rounded-md font-bold bg-accent/15 text-accent text-xs">패턴명</span>
          <span class="text-muted-foreground">15년 데이터 내 발견: <b id="pat-count" class="text-foreground">0</b>건</span>
        </div>
        <div class="flex items-center gap-1.5">
          <button id="btn-pat-prev" class="px-2.5 py-1 rounded-lg border border-border bg-background hover:bg-muted font-medium transition-colors cursor-pointer">◀ 이전 시점</button>
          <span id="pat-current-idx" class="font-mono text-muted-foreground px-1">0 / 0</span>
          <button id="btn-pat-next" class="px-2.5 py-1 rounded-lg border border-border bg-background hover:bg-muted font-medium transition-colors cursor-pointer">다음 시점 ▶</button>
        </div>
      </div>

      <!-- Occurrence tags -->
      <div id="pat-list-container" class="flex gap-2 overflow-x-auto py-1 scrollbar-thin"></div>
    </div>

    <!-- Live Legend / Tooltip Info -->
    <div id="chart-legend" class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-mono text-muted-foreground min-h-[22px]">
      <span>일자: <b id="leg-date" class="text-foreground">-</b></span>
      <span>시: <b id="leg-open" class="text-foreground">-</b></span>
      <span>고: <b id="leg-high" class="text-foreground">-</b></span>
      <span>저: <b id="leg-low" class="text-foreground">-</b></span>
      <span>종: <b id="leg-close" class="text-foreground">-</b></span>
      <span>거래량: <b id="leg-vol" class="text-foreground">-</b></span>
      <span id="leg-ma-container" class="hidden sm:inline-flex gap-2"></span>
    </div>

    <!-- Main Chart Canvas -->
    <div class="relative">
      <div id="tv-chart-container" class="relative h-[420px] w-full overflow-hidden rounded-xl border border-border/80 bg-background"></div>
      <div id="chart-loading" class="absolute inset-0 flex items-center justify-center bg-background/80 backdrop-blur-xs z-20 transition-opacity pointer-events-none hidden">
        <div class="flex items-center gap-2 text-sm text-muted-foreground font-medium bg-background px-4 py-2 rounded-xl border border-border shadow-sm">
          <svg class="size-5 animate-spin text-accent" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          일봉 차트 로딩 중...
        </div>
      </div>
    </div>

    <!-- Sub Chart Canvas (RSI / MACD) -->
    <div id="tv-subchart-container" class="relative h-[160px] w-full overflow-hidden rounded-xl border border-border/80 bg-background">
      <div id="subchart-title" class="absolute left-3 top-2 z-10 text-[11px] font-bold font-mono text-muted-foreground">RSI (14)</div>
    </div>
  </div>

  <!-- Section 2: Backtester View -->
  <div id="section-backtest" class="hidden flex-col gap-6">
    <!-- Strategy Configuration Card -->
    <div class="rounded-xl border border-border bg-muted/20 p-4 sm:p-5">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-base font-bold text-foreground flex items-center gap-2">
          <span>⚙️</span> 전략 파라미터 설정
        </h3>
        <span class="text-xs text-muted-foreground">차트에 로드된 일봉 데이터로 즉시 시뮬레이션</span>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Strategy Selection -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-muted-foreground">매매 전략 선택</label>
          <select id="bt-strategy" class="rounded-xl border border-border bg-background px-3 py-2 text-sm font-medium text-foreground focus:border-accent focus:outline-none">
            <optgroup label="🎓 [강의 실전 기법] 1-1강 & 1-2강">
              <option value="LECTURE_INVERTED_HAMMER">🔨 [1-1강 실전] 바닥권 역망치 매집봉 (거래량 폭증+위꼬리)</option>
              <option value="LECTURE_BULLISH_ENGULFING" selected>🟢 [1-2강 실전] 20일선 눌림목 상승장악형 (Bullish Engulfing)</option>
              <option value="LECTURE_BEARISH_ENGULFING">⚠️ [1-2강 경고] 고점 하락장악형 (설거지 장대음봉 탈출)</option>
            </optgroup>
            <optgroup label="📊 [클래식] 퀀트 모멘텀 전략">
              <option value="MA_CROSS">이평선 골든크로스 (5일/20일)</option>
              <option value="RSI_OVERSOLD">RSI 과매도 반등 (30 이하 매수)</option>
              <option value="BOLLINGER_REVERSAL">볼린저 밴드 하단 반등 매매</option>
              <option value="BREAKOUT_HIGH">20일 신고가 돌파 매매</option>
              <option value="SURGE_PULLBACK">10%+ 급등 후 눌림목 반등</option>
              <option value="VOLUME_SURGE">거래량 폭증(300%+) 장대양봉 돌파</option>
              <option value="MA_ALIGN_BULL">이평선 정배열 전환 (5>20>60일선)</option>
              <option value="MACD_GOLDEN_CROSS">MACD 시그널 골든크로스</option>
              <option value="VOLATILITY_BREAKOUT">래리 윌리엄스 변동성 돌파 (k=0.5)</option>
              <option value="DISPARITY_OVERSOLD">20일선 이격도 과매도(-10%) 반등</option>
              <option value="HIGH_52W_BREAKOUT">52주(250일) 신고가 돌파 매매</option>
            </optgroup>
          </select>
        </div>

        <!-- Take Profit -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-muted-foreground">익절 목표 (%) <span class="font-normal text-muted-foreground">(0은 무제한)</span></label>
          <input type="number" id="bt-tp" value="10" min="0" max="100" step="0.5" class="rounded-xl border border-border bg-background px-3 py-2 text-sm font-mono font-medium text-foreground focus:border-accent focus:outline-none" />
        </div>

        <!-- Stop Loss -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-muted-foreground">손절 제한 (%) <span class="font-normal text-muted-foreground">(0은 무제한)</span></label>
          <input type="number" id="bt-sl" value="5" min="0" max="50" step="0.5" class="rounded-xl border border-border bg-background px-3 py-2 text-sm font-mono font-medium text-foreground focus:border-accent focus:outline-none" />
        </div>

        <!-- Max Holding Days -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-muted-foreground">최대 보유 영업일 <span class="font-normal text-muted-foreground">(0은 무제한)</span></label>
          <input type="number" id="bt-max-days" value="20" min="0" max="250" step="1" class="rounded-xl border border-border bg-background px-3 py-2 text-sm font-mono font-medium text-foreground focus:border-accent focus:outline-none" />
        </div>
      </div>

      <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between border-t border-border/60 pt-3">
        <div class="flex items-center gap-4 text-xs text-muted-foreground">
          <span class="flex items-center gap-1">
            <span class="inline-block size-2 rounded-full bg-accent"></span>
            수수료/세금: <b>0.2%</b> (매매당 자동 차감)
          </span>
        </div>

        <button
          id="btn-run-backtest"
          class="flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-2.5 text-sm font-bold text-white shadow-md hover:opacity-90 transition-opacity cursor-pointer"
        >
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          전략 백테스트 실행
        </button>
      </div>
    </div>

    <!-- KPI Summary Grid -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      <div class="rounded-xl border border-border bg-background p-3.5 shadow-xs">
        <span class="text-xs text-muted-foreground font-medium">총 누적 수익률</span>
        <div id="kpi-return" class="text-lg font-bold font-mono mt-1 text-foreground">-</div>
      </div>
      <div class="rounded-xl border border-border bg-background p-3.5 shadow-xs">
        <span class="text-xs text-muted-foreground font-medium">단순 보유 수익률</span>
        <div id="kpi-bnh" class="text-lg font-bold font-mono mt-1 text-foreground">-</div>
      </div>
      <div class="rounded-xl border border-border bg-background p-3.5 shadow-xs">
        <span class="text-xs text-muted-foreground font-medium">승률 (Win Rate)</span>
        <div id="kpi-winrate" class="text-lg font-bold font-mono mt-1 text-foreground">-</div>
      </div>
      <div class="rounded-xl border border-border bg-background p-3.5 shadow-xs">
        <span class="text-xs text-muted-foreground font-medium">손익비 (Profit Factor)</span>
        <div id="kpi-pf" class="text-lg font-bold font-mono mt-1 text-foreground">-</div>
      </div>
      <div class="rounded-xl border border-border bg-background p-3.5 shadow-xs">
        <span class="text-xs text-muted-foreground font-medium">최대 낙폭 (MDD)</span>
        <div id="kpi-mdd" class="text-lg font-bold font-mono mt-1 text-foreground">-</div>
      </div>
      <div class="rounded-xl border border-border bg-background p-3.5 shadow-xs">
        <span class="text-xs text-muted-foreground font-medium">총 거래 횟수</span>
        <div id="kpi-trades" class="text-lg font-bold font-mono mt-1 text-foreground">-</div>
      </div>
    </div>

    <!-- Trade History Log Table -->
    <div class="rounded-xl border border-border bg-background shadow-xs overflow-hidden">
      <div class="border-b border-border/80 px-4 py-3 bg-muted/20 flex items-center justify-between">
        <h4 class="text-sm font-bold text-foreground">매매 거래 내역 (최근 순)</h4>
        <span id="trade-log-count" class="text-xs text-muted-foreground font-mono">0건의 거래</span>
      </div>
      <div class="max-h-80 overflow-y-auto overflow-x-auto">
        <table class="w-full text-left text-xs font-mono">
          <thead class="sticky top-0 bg-muted/80 text-muted-foreground backdrop-blur-xs">
            <tr class="border-b border-border">
              <th class="py-2.5 px-3">No</th>
              <th class="py-2.5 px-3">진입일</th>
              <th class="py-2.5 px-3">진입가</th>
              <th class="py-2.5 px-3">청산일</th>
              <th class="py-2.5 px-3">청산가</th>
              <th class="py-2.5 px-3">보유일</th>
              <th class="py-2.5 px-3">수익률</th>
              <th class="py-2.5 px-3">청산 사유</th>
            </tr>
          </thead>
          <tbody id="trade-log-tbody" class="divide-y divide-border/60 font-medium">
            <tr>
              <td colspan="8" class="py-6 text-center text-muted-foreground font-sans">
                '전략 백테스트 실행' 버튼을 클릭하여 시뮬레이션을 시작하세요.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  import { createChart, ColorType, LineStyle, createSeriesMarkers, CandlestickSeries, HistogramSeries, LineSeries } from "lightweight-charts";
  import {
    calculateSMA,
    calculateBollingerBands,
    calculateRSI,
    calculateMACD,
  } from "@/utils/technicalIndicators";
  import {
    runBacktest,
    detectLecturePatternPoints,
    type StrategyType,
    type LecturePatternPoint,
  } from "@/utils/backtestEngine";

  let stockList: Array<{ code: string; name: string; bars: number; lastClose: number }> = [];
  let currentStockData: any[] = [];
  let currentCode = "000660";
  let currentName = "SK하이닉스";

  let mainChart: any = null;
  let subChart: any = null;

  let candleSeries: any = null;
  let volumeSeries: any = null;
  let markersPrimitive: any = null;

  let maSeries5: any = null;
  let maSeries20: any = null;
  let maSeries60: any = null;
  let maSeries120: any = null;

  let bbUpperSeries: any = null;
  let bbMiddleSeries: any = null;
  let bbLowerSeries: any = null;

  let rsiSeries: any = null;
  let macdLineSeries: any = null;
  let macdSignalSeries: any = null;
  let macdHistSeries: any = null;

  // Lecture Pattern state
  let currentLecturePoints: LecturePatternPoint[] = [];
  let currentPatternIndex: number = 0;

  const isDarkMode = () =>
    document.documentElement.classList.contains("dark") ||
    document.documentElement.getAttribute("data-theme") === "dark";

  function getThemeColors() {
    const dark = isDarkMode();
    return {
      bg: dark ? "#1a1b26" : "#ffffff",
      text: dark ? "#9aa5ce" : "#374151",
      grid: dark ? "rgba(255, 255, 255, 0.05)" : "rgba(0, 0, 0, 0.05)",
      border: dark ? "rgba(255, 255, 255, 0.1)" : "rgba(0, 0, 0, 0.1)",
      upColor: "#ef5350",
      downColor: "#26a69a",
    };
  }

  function initCharts() {
    const mainContainer = document.getElementById("tv-chart-container");
    const subContainer = document.getElementById("tv-subchart-container");
    if (!mainContainer || !subContainer) return;

    if (mainChart) {
      try { mainChart.remove(); } catch(e) {}
      mainChart = null;
    }
    if (subChart) {
      try { subChart.remove(); } catch(e) {}
      subChart = null;
    }

    mainContainer.innerHTML = "";
    subContainer.innerHTML = '<div id="subchart-title" class="absolute left-3 top-2 z-10 text-[11px] font-bold font-mono text-muted-foreground">RSI (14)</div>';

    const colors = getThemeColors();

    mainChart = createChart(mainContainer, {
      layout: {
        background: { type: ColorType.Solid, color: "transparent" },
        textColor: colors.text,
        attributionLogo: false,
      },
      grid: {
        vertLines: { color: colors.grid },
        horzLines: { color: colors.grid },
      },
      timeScale: {
        borderColor: colors.border,
        timeVisible: true,
      },
      rightPriceScale: {
        borderColor: colors.border,
        scaleMargins: { top: 0.1, bottom: 0.25 },
      },
      crosshair: {
        vertLine: { labelBackgroundColor: "#6366f1" },
        horzLine: { labelBackgroundColor: "#6366f1" },
      },
    });

    candleSeries = mainChart.addSeries(CandlestickSeries, {
      upColor: colors.upColor,
      downColor: colors.downColor,
      borderUpColor: colors.upColor,
      borderDownColor: colors.downColor,
      wickUpColor: colors.upColor,
      wickDownColor: colors.downColor,
    });

    volumeSeries = mainChart.addSeries(HistogramSeries, {
      priceFormat: { type: "volume" },
      priceScaleId: "",
    });
    volumeSeries.priceScale().applyOptions({
      scaleMargins: { top: 0.8, bottom: 0 },
    });

    maSeries5 = mainChart.addSeries(LineSeries, { color: "#e91e63", lineWidth: 1.5, title: "MA5" });
    maSeries20 = mainChart.addSeries(LineSeries, { color: "#ff9800", lineWidth: 1.8, title: "MA20" });
    maSeries60 = mainChart.addSeries(LineSeries, { color: "#4caf50", lineWidth: 1.5, title: "MA60" });
    maSeries120 = mainChart.addSeries(LineSeries, { color: "#9c27b0", lineWidth: 1.5, title: "MA120" });

    bbUpperSeries = mainChart.addSeries(LineSeries, { color: "#00bcd4", lineWidth: 1, lineStyle: LineStyle.Dashed });
    bbMiddleSeries = mainChart.addSeries(LineSeries, { color: "#00bcd4", lineWidth: 1 });
    bbLowerSeries = mainChart.addSeries(LineSeries, { color: "#00bcd4", lineWidth: 1, lineStyle: LineStyle.Dashed });

    subChart = createChart(subContainer, {
      layout: {
        background: { type: ColorType.Solid, color: "transparent" },
        textColor: colors.text,
        attributionLogo: false,
      },
      grid: {
        vertLines: { color: colors.grid },
        horzLines: { color: colors.grid },
      },
      timeScale: {
        borderColor: colors.border,
        visible: false,
      },
      rightPriceScale: {
        borderColor: colors.border,
        scaleMargins: { top: 0.1, bottom: 0.1 },
      },
    });

    rsiSeries = subChart.addSeries(LineSeries, { color: "#e91e63", lineWidth: 1.5 });
    macdLineSeries = subChart.addSeries(LineSeries, { color: "#2196f3", lineWidth: 1.5 });
    macdSignalSeries = subChart.addSeries(LineSeries, { color: "#ff9800", lineWidth: 1.5 });
    macdHistSeries = subChart.addSeries(HistogramSeries, { color: "#26a69a" });

    mainChart.timeScale().subscribeVisibleLogicalRangeChange((range: any) => {
      if (range && subChart) subChart.timeScale().setVisibleLogicalRange(range);
    });

    mainChart.subscribeCrosshairMove((param: any) => {
      if (!param || !param.time || !param.seriesData.get(candleSeries)) {
        updateLegendDefault();
        return;
      }
      const c = param.seriesData.get(candleSeries);
      const v = param.seriesData.get(volumeSeries);
      const d = param.time;

      const dateEl = document.getElementById("leg-date");
      const openEl = document.getElementById("leg-open");
      const highEl = document.getElementById("leg-high");
      const lowEl = document.getElementById("leg-low");
      const closeEl = document.getElementById("leg-close");
      const volEl = document.getElementById("leg-vol");

      if (dateEl) dateEl.innerText = typeof d === "string" ? d : `${d.year}-${d.month}-${d.day}`;
      if (openEl) openEl.innerText = c.open?.toLocaleString() ?? "-";
      if (highEl) highEl.innerText = c.high?.toLocaleString() ?? "-";
      if (lowEl) lowEl.innerText = c.low?.toLocaleString() ?? "-";
      if (closeEl) closeEl.innerText = c.close?.toLocaleString() ?? "-";
      if (volEl) volEl.innerText = v?.value?.toLocaleString() ?? "-";
    });

    const resizeObserver = new ResizeObserver(() => {
      if (mainContainer && mainChart) mainChart.applyOptions({ width: mainContainer.clientWidth });
      if (subContainer && subChart) subChart.applyOptions({ width: subContainer.clientWidth });
    });
    resizeObserver.observe(mainContainer);
  }

  function updateLegendDefault() {
    if (!currentStockData || currentStockData.length === 0) return;
    const last = currentStockData[currentStockData.length - 1];
    const dateEl = document.getElementById("leg-date");
    const openEl = document.getElementById("leg-open");
    const highEl = document.getElementById("leg-high");
    const lowEl = document.getElementById("leg-low");
    const closeEl = document.getElementById("leg-close");
    const volEl = document.getElementById("leg-vol");

    if (dateEl) dateEl.innerText = last.time;
    if (openEl) openEl.innerText = last.open.toLocaleString();
    if (highEl) highEl.innerText = last.high.toLocaleString();
    if (lowEl) lowEl.innerText = last.low.toLocaleString();
    if (closeEl) closeEl.innerText = last.close.toLocaleString();
    if (volEl) volEl.innerText = last.volume.toLocaleString();
  }

  async function loadStock(code: string, knownName?: string) {
    const loadingEl = document.getElementById("chart-loading");
    if (loadingEl) loadingEl.classList.remove("hidden");

    try {
      const resp = await fetch(`https://pub-88fccd299b1d47fe97d43f35f238d0ce.r2.dev/data/daily/${code}.json`);
      if (!resp.ok) throw new Error("데이터를 찾을 수 없습니다.");
      const data = await resp.json();
      currentStockData = data;
      currentCode = code;

      const stockInfo = stockList.find(s => s.code === code);
      const displayName = knownName || stockInfo?.name || code;
      currentName = displayName;

      const stockNameEl = document.getElementById("current-stock-name");
      const stockCodeEl = document.getElementById("current-stock-code");
      const stockBarsEl = document.getElementById("current-stock-bars");
      const stockPriceEl = document.getElementById("current-stock-price");
      const stockChangeEl = document.getElementById("current-stock-change");

      if (stockNameEl) stockNameEl.innerText = displayName;
      if (stockCodeEl) stockCodeEl.innerText = code;
      if (stockBarsEl) stockBarsEl.innerText = `${data.length}일 일봉`;

      if (data.length > 0) {
        const last = data[data.length - 1];
        const prev = data.length > 1 ? data[data.length - 2] : last;
        const diff = last.close - prev.close;
        const pct = prev.close > 0 ? (diff / prev.close) * 100 : 0;

        if (stockPriceEl) stockPriceEl.innerText = `${last.close.toLocaleString()} 원`;
        if (stockChangeEl) {
          const sign = diff > 0 ? "+" : "";
          stockChangeEl.innerText = `${sign}${diff.toLocaleString()}원 (${sign}${pct.toFixed(2)}%)`;
          stockChangeEl.className = `text-sm font-semibold font-mono ${diff > 0 ? "text-red-500" : diff < 0 ? "text-blue-500" : "text-foreground"}`;
        }
      }

      if (candleSeries) candleSeries.setData(data);

      const volData = data.map((d: any, i: number) => {
        const prevClose = i > 0 ? data[i - 1].close : d.open;
        return {
          time: d.time,
          value: d.volume,
          color: d.close >= prevClose ? "rgba(239, 83, 80, 0.4)" : "rgba(38, 166, 154, 0.4)",
        };
      });
      if (volumeSeries) volumeSeries.setData(volData);

      updateIndicators();
      updateSubChart();

      mainChart?.timeScale().fitContent();
      updateLegendDefault();

      // Check lecture pattern selection
      const patSelect = (document.getElementById("select-lecture-pattern") as HTMLSelectElement)?.value;
      if (patSelect && patSelect !== "NONE") {
        applyLecturePattern(patSelect);
      } else {
        clearLecturePattern();
      }
    } catch (e) {
      console.error(e);
    } finally {
      if (loadingEl) loadingEl.classList.add("hidden");
    }
  }

  function updateIndicators() {
    if (!currentStockData || currentStockData.length === 0) return;

    const showMa5 = (document.getElementById("toggle-ma-5") as HTMLInputElement)?.checked;
    const showMa20 = (document.getElementById("toggle-ma-20") as HTMLInputElement)?.checked;
    const showMa60 = (document.getElementById("toggle-ma-60") as HTMLInputElement)?.checked;
    const showMa120 = (document.getElementById("toggle-ma-120") as HTMLInputElement)?.checked;
    const showBB = (document.getElementById("toggle-bb") as HTMLInputElement)?.checked;

    if (maSeries5) maSeries5.setData(showMa5 ? calculateSMA(currentStockData, 5) : []);
    if (maSeries20) maSeries20.setData(showMa20 ? calculateSMA(currentStockData, 20) : []);
    if (maSeries60) maSeries60.setData(showMa60 ? calculateSMA(currentStockData, 60) : []);
    if (maSeries120) maSeries120.setData(showMa120 ? calculateSMA(currentStockData, 120) : []);

    if (showBB) {
      const bb = calculateBollingerBands(currentStockData, 20, 2);
      bbUpperSeries?.setData(bb.upper);
      bbMiddleSeries?.setData(bb.middle);
      bbLowerSeries?.setData(bb.lower);
    } else {
      bbUpperSeries?.setData([]);
      bbMiddleSeries?.setData([]);
      bbLowerSeries?.setData([]);
    }
  }

  function updateSubChart() {
    if (!currentStockData || currentStockData.length === 0) return;
    const select = (document.getElementById("select-sub-indicator") as HTMLSelectElement)?.value;
    const subContainer = document.getElementById("tv-subchart-container");
    const subTitle = document.getElementById("subchart-title");

    if (select === "none") {
      if (subContainer) subContainer.classList.add("hidden");
      return;
    }

    if (subContainer) subContainer.classList.remove("hidden");

    if (select === "rsi") {
      if (subTitle) subTitle.innerText = "RSI (14)";
      rsiSeries?.applyOptions({ visible: true });
      macdLineSeries?.applyOptions({ visible: false });
      macdSignalSeries?.applyOptions({ visible: false });
      macdHistSeries?.applyOptions({ visible: false });
      rsiSeries?.setData(calculateRSI(currentStockData, 14));
    } else if (select === "macd") {
      if (subTitle) subTitle.innerText = "MACD (12, 26, 9)";
      rsiSeries?.applyOptions({ visible: false });
      macdLineSeries?.applyOptions({ visible: true });
      macdSignalSeries?.applyOptions({ visible: true });
      macdHistSeries?.applyOptions({ visible: true });
      const macd = calculateMACD(currentStockData, 12, 26, 9);
      macdLineSeries?.setData(macd.macd);
      macdSignalSeries?.setData(macd.signal);
      macdHistSeries?.setData(macd.histogram);
    }
    subChart?.priceScale("right").applyOptions({ autoScale: true });
    subChart?.timeScale().fitContent();
  }

  // --- Lecture Pattern Finder logic ---
  function clearLecturePattern() {
    currentLecturePoints = [];
    currentPatternIndex = 0;
    const navPanel = document.getElementById("lecture-pattern-navigator");
    if (navPanel) navPanel.classList.add("hidden");

    if (candleSeries) {
      if (typeof (candleSeries as any).setMarkers === "function") {
        (candleSeries as any).setMarkers([]);
      } else if (markersPrimitive) {
        try { markersPrimitive.setMarkers([]); } catch(e) {}
      }
    }
  }

  function applyLecturePattern(patternKey: string) {
    if (!currentStockData || currentStockData.length === 0 || patternKey === "NONE") {
      clearLecturePattern();
      return;
    }

    currentLecturePoints = detectLecturePatternPoints(currentStockData, patternKey as StrategyType);
    const navPanel = document.getElementById("lecture-pattern-navigator");
    const patBadge = document.getElementById("pat-badge");
    const patCount = document.getElementById("pat-count");
    const patListContainer = document.getElementById("pat-list-container");

    if (navPanel) navPanel.classList.remove("hidden");

    const titleMap: Record<string, string> = {
      LECTURE_INVERTED_HAMMER: "🔨 [1-1강 실전] 역망치 매집봉",
      LECTURE_BULLISH_ENGULFING: "🟢 [1-2강 실전] 20일선 상승장악형",
      LECTURE_BEARISH_ENGULFING: "⚠️ [1-2강 경고] 고점 하락장악형",
    };

    if (patBadge) patBadge.innerText = titleMap[patternKey] || patternKey;
    if (patCount) patCount.innerText = `${currentLecturePoints.length}`;

    // Set markers on candle series
    const markers = currentLecturePoints.map(p => p.marker);
    if (candleSeries) {
      if (typeof (candleSeries as any).setMarkers === "function") {
        (candleSeries as any).setMarkers(markers);
      } else if (typeof createSeriesMarkers === "function") {
        if (markersPrimitive) {
          try { markersPrimitive.setMarkers(markers); } catch(e) {}
        } else {
          markersPrimitive = createSeriesMarkers(candleSeries, markers);
        }
      }
    }

    // Render occurrence badges
    if (patListContainer) {
      if (currentLecturePoints.length === 0) {
        patListContainer.innerHTML = '<span class="text-xs text-muted-foreground py-1">현재 종목의 15년 데이터에서 해당 패턴 조건을 만족하는 시점이 없습니다.</span>';
      } else {
        patListContainer.innerHTML = currentLecturePoints
          .map((p, idx) => `
            <button
              class="pat-chip shrink-0 flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-border bg-background hover:border-accent hover:bg-accent/10 font-mono text-xs text-foreground transition-all cursor-pointer ${idx === currentLecturePoints.length - 1 ? 'border-accent ring-1 ring-accent/30 bg-accent/10 font-bold' : ''}"
              data-idx="${idx}"
            >
              <span>${p.time}</span>
              <span class="text-[10px] text-muted-foreground">${p.price.toLocaleString()}원</span>
              <span class="text-[10px] px-1 rounded bg-muted text-muted-foreground font-sans">Vol ${p.volumeRatio}x</span>
            </button>
          `)
          .join("");

        patListContainer.querySelectorAll(".pat-chip").forEach(chip => {
          chip.addEventListener("click", () => {
            const idx = parseInt((chip as HTMLElement).dataset.idx || "0");
            jumpToPatternIndex(idx);
          });
        });
      }
    }

    if (currentLecturePoints.length > 0) {
      jumpToPatternIndex(currentLecturePoints.length - 1);
    }
  }

  function jumpToPatternIndex(idx: number) {
    if (!currentLecturePoints || currentLecturePoints.length === 0) return;
    if (idx < 0) idx = 0;
    if (idx >= currentLecturePoints.length) idx = currentLecturePoints.length - 1;
    currentPatternIndex = idx;

    const currentIdxEl = document.getElementById("pat-current-idx");
    if (currentIdxEl) currentIdxEl.innerText = `${idx + 1} / ${currentLecturePoints.length}`;

    // Update active style on chips
    const chips = document.querySelectorAll(".pat-chip");
    chips.forEach((c, i) => {
      if (i === idx) {
        c.className = "pat-chip shrink-0 flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-accent ring-1 ring-accent/30 bg-accent/15 font-mono text-xs text-foreground font-bold transition-all cursor-pointer";
        (c as HTMLElement).scrollIntoView({ behavior: "smooth", inline: "nearest", block: "nearest" });
      } else {
        c.className = "pat-chip shrink-0 flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-border bg-background hover:border-accent hover:bg-accent/10 font-mono text-xs text-foreground transition-all cursor-pointer";
      }
    });

    const pt = currentLecturePoints[idx];
    const startIdx = Math.max(0, pt.index - 14);
    const endIdx = Math.min(currentStockData.length - 1, pt.index + 20);

    mainChart?.timeScale().setVisibleRange({
      from: currentStockData[startIdx].time,
      to: currentStockData[endIdx].time,
    });
  }

  function executeBacktest() {
    if (!currentStockData || currentStockData.length === 0) return;

    const strategy = (document.getElementById("bt-strategy") as HTMLSelectElement)?.value as StrategyType;
    const tp = parseFloat((document.getElementById("bt-tp") as HTMLInputElement)?.value || "0");
    const sl = parseFloat((document.getElementById("bt-sl") as HTMLInputElement)?.value || "0");
    const maxDays = parseInt((document.getElementById("bt-max-days") as HTMLInputElement)?.value || "0");

    const result = runBacktest(currentStockData, {
      strategy,
      takeProfitPct: tp > 0 ? tp : undefined,
      stopLossPct: sl > 0 ? sl : undefined,
      maxHoldDays: maxDays > 0 ? maxDays : undefined,
    });

    const kpiReturn = document.getElementById("kpi-return");
    const kpiBnh = document.getElementById("kpi-bnh");
    const kpiWinrate = document.getElementById("kpi-winrate");
    const kpiPf = document.getElementById("kpi-pf");
    const kpiMdd = document.getElementById("kpi-mdd");
    const kpiTrades = document.getElementById("kpi-trades");

    if (kpiReturn) {
      kpiReturn.innerText = `${result.totalReturnPct >= 0 ? "+" : ""}${result.totalReturnPct.toFixed(2)}%`;
      kpiReturn.className = `text-lg font-bold font-mono mt-1 ${result.totalReturnPct >= 0 ? "text-red-500" : "text-blue-500"}`;
    }
    if (kpiBnh) kpiBnh.innerText = `${result.buyAndHoldReturnPct >= 0 ? "+" : ""}${result.buyAndHoldReturnPct.toFixed(2)}%`;
    if (kpiWinrate) kpiWinrate.innerText = `${result.winRatePct.toFixed(1)}% (${result.winCount}승 ${result.lossCount}패)`;
    if (kpiPf) kpiPf.innerText = `${result.profitFactor.toFixed(2)}`;
    if (kpiMdd) kpiMdd.innerText = `-${result.maxDrawdownPct.toFixed(2)}%`;
    if (kpiTrades) kpiTrades.innerText = `${result.totalTrades}회`;

    const tbody = document.getElementById("trade-log-tbody");
    const countEl = document.getElementById("trade-log-count");
    if (countEl) countEl.innerText = `총 ${result.trades.length}건의 거래`;

    if (tbody) {
      if (result.trades.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="py-6 text-center text-muted-foreground font-sans">조건에 만족하는 매매 신호가 발생하지 않았습니다.</td></tr>';
      } else {
        tbody.innerHTML = result.trades
          .map(
            (t, idx) => `
          <tr class="hover:bg-muted/30 transition-colors">
            <td class="py-2.5 px-3 text-muted-foreground">${idx + 1}</td>
            <td class="py-2.5 px-3">${t.entryDate}</td>
            <td class="py-2.5 px-3">${t.entryPrice.toLocaleString()}</td>
            <td class="py-2.5 px-3">${t.exitDate}</td>
            <td class="py-2.5 px-3">${t.exitPrice.toLocaleString()}</td>
            <td class="py-2.5 px-3">${t.holdDays}일</td>
            <td class="py-2.5 px-3 font-bold ${t.returnPct >= 0 ? "text-red-500" : "text-blue-500"}">
              ${t.returnPct >= 0 ? "+" : ""}${t.returnPct.toFixed(2)}%
            </td>
            <td class="py-2.5 px-3">
              <span class="rounded px-1.5 py-0.5 text-[10px] font-bold ${
                t.exitReason === "TP"
                  ? "bg-red-500/10 text-red-500"
                  : t.exitReason === "SL"
                    ? "bg-blue-500/10 text-blue-500"
                    : "bg-muted text-muted-foreground"
              }">${t.exitReason}</span>
            </td>
          </tr>`
          )
          .join("");
      }
    }

    // Set Chart Markers
    if (candleSeries && result.markers) {
      if (typeof (candleSeries as any).setMarkers === "function") {
        (candleSeries as any).setMarkers(result.markers);
      } else if (typeof createSeriesMarkers === "function") {
        if (markersPrimitive) {
          try { markersPrimitive.setMarkers(result.markers); } catch(e) {}
        } else {
          markersPrimitive = createSeriesMarkers(candleSeries, result.markers);
        }
      }
    }
  }

  function setup() {
    initCharts();
    loadStock(currentCode, currentName);

    fetch("https://pub-88fccd299b1d47fe97d43f35f238d0ce.r2.dev/data/stock_list.json")
      .then(r => r.json())
      .then(data => {
        stockList = data;
      })
      .catch(e => console.error("Stock list fetch error:", e));

    const searchInput = document.getElementById("stock-search-input") as HTMLInputElement;
    const searchDropdown = document.getElementById("stock-search-dropdown");

    if (searchInput && searchDropdown) {
      searchInput.addEventListener("input", () => {
        const query = searchInput.value.trim().toLowerCase();
        if (!query) {
          searchDropdown.classList.add("hidden");
          return;
        }

        const filtered = stockList
          .filter(s => s.name.toLowerCase().includes(query) || s.code.includes(query))
          .slice(0, 10);

        if (filtered.length === 0) {
          searchDropdown.innerHTML = '<div class="px-4 py-3 text-xs text-muted-foreground text-center">검색 결과가 없습니다.</div>';
        } else {
          searchDropdown.innerHTML = filtered
            .map(
              s => `
            <button class="search-item flex w-full items-center justify-between px-4 py-2 text-left text-xs hover:bg-muted transition-colors" data-code="${s.code}" data-name="${s.name}">
              <span class="font-medium text-foreground">${s.name}</span>
              <span class="font-mono text-muted-foreground">${s.code}</span>
            </button>`
            )
            .join("");
        }
        searchDropdown.classList.remove("hidden");
      });

      searchDropdown.addEventListener("click", e => {
        const btn = (e.target as HTMLElement).closest(".search-item") as HTMLElement;
        if (btn && btn.dataset.code) {
          loadStock(btn.dataset.code, btn.dataset.name);
          searchInput.value = "";
          searchDropdown.classList.add("hidden");
        }
      });

      document.addEventListener("click", e => {
        if (!searchInput.contains(e.target as Node) && !searchDropdown.contains(e.target as Node)) {
          searchDropdown.classList.add("hidden");
        }
      });
    }

    document.querySelectorAll(".quick-stock-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const code = (btn as HTMLElement).dataset.code;
        const name = (btn as HTMLElement).dataset.name;
        if (code) loadStock(code, name);
      });
    });

    const tabChart = document.getElementById("tab-btn-chart");
    const tabBacktest = document.getElementById("tab-btn-backtest");
    const sectionChart = document.getElementById("section-chart");
    const sectionBacktest = document.getElementById("section-backtest");

    tabChart?.addEventListener("click", () => {
      tabChart.className = "tab-btn active-tab flex items-center gap-1.5 border-b-2 border-accent px-4 py-2.5 text-sm font-bold text-accent transition-colors";
      tabBacktest?.classList.remove("active-tab", "border-accent", "text-accent", "font-bold");
      tabBacktest?.classList.add("border-transparent", "text-muted-foreground", "font-medium");
      sectionChart?.classList.remove("hidden");
      sectionBacktest?.classList.add("hidden");
      mainChart?.timeScale().fitContent();

      // If lecture pattern is active, restore its markers
      const patSelect = (document.getElementById("select-lecture-pattern") as HTMLSelectElement)?.value;
      if (patSelect && patSelect !== "NONE") {
        applyLecturePattern(patSelect);
      }
    });

    tabBacktest?.addEventListener("click", () => {
      tabBacktest.className = "tab-btn active-tab flex items-center gap-1.5 border-b-2 border-accent px-4 py-2.5 text-sm font-bold text-accent transition-colors";
      tabChart?.classList.remove("active-tab", "border-accent", "text-accent", "font-bold");
      tabChart?.classList.add("border-transparent", "text-muted-foreground", "font-medium");
      sectionBacktest?.classList.remove("hidden");
      sectionChart?.classList.add("hidden");
      executeBacktest();
    });

    ["toggle-ma-5", "toggle-ma-20", "toggle-ma-60", "toggle-ma-120", "toggle-bb"].forEach(id => {
      document.getElementById(id)?.addEventListener("change", updateIndicators);
    });

    document.getElementById("select-sub-indicator")?.addEventListener("change", updateSubChart);

    // Lecture Pattern change listener
    document.getElementById("select-lecture-pattern")?.addEventListener("change", e => {
      const val = (e.target as HTMLSelectElement).value;
      applyLecturePattern(val);
    });

    // Pattern navigator buttons
    document.getElementById("btn-pat-prev")?.addEventListener("click", () => {
      if (currentLecturePoints.length > 0 && currentPatternIndex > 0) {
        jumpToPatternIndex(currentPatternIndex - 1);
      }
    });

    document.getElementById("btn-pat-next")?.addEventListener("click", () => {
      if (currentLecturePoints.length > 0 && currentPatternIndex < currentLecturePoints.length - 1) {
        jumpToPatternIndex(currentPatternIndex + 1);
      }
    });

    document.getElementById("btn-fit-chart")?.addEventListener("click", () => {
      mainChart?.timeScale().fitContent();
      subChart?.timeScale().fitContent();
    });

    document.getElementById("btn-run-backtest")?.addEventListener("click", () => {
      executeBacktest();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup);
  } else {
    setup();
  }
  document.addEventListener("astro:after-swap", setup);
</script>
